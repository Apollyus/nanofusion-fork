{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920, 2048, 3840],
    "domains": ["mgmtkdwvhgrzefmyucvr.supabase.co"],
    "minimumCacheTTL": 3600
  },
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin-panel/:path*"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/((?!admin|api|assets|static|faq|o-nas|sluzby).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true
}
